# Secrets and local config. Never commit these
*.env
.env
*.pem
*.key
*.crt
!*.example
# The filled-in config. config.example.yaml is the committed template; this is
# the copy that carries real values, so it must never be tracked.
config.yaml
config.yml

# Proprietary vendor SDK material (Thales ProtectToolkit and friends).
# Licensed, non-redistributable, and never vendored into this repository;
#. These patterns are a safety net, not the
# policy; the policy is that vendor code lives outside the repo entirely.
libctsw.so
libcthsm.so
libcryptoki.so
libctsw.so.*
libcthsm.so.*
libcryptoki.so.*
/opt/
*.fm
terraform.tfstate
terraform.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Go
/bin/
*.test
*.out
coverage.txt
# `go build ./ci/<name>` and `go build ./cmd/<name>` drop a binary named
# after the package in whatever directory they were run from, usually the
# repository root. It has no extension, so no pattern above catches it, and
# one was committed by accident before these lines existed.
/check-pin-freshness
/generate-image-policy
/select-key
/token-cleanup
/verify-artifact
/vuln-gate
/hsm-pki-keytool
/hsm-pki-server

# OS / editor
.DS_Store
.idea/
.vscode/

# Local run state created by deploy/docker/run-local.sh: SoftHSM2 tokens
# (which hold real private keys, throwaway or not), ceremony artifacts, and
# the CA database. Never committed -- the key-and-PIN rule and the no-secrets rule.
.local/
