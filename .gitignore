# Secrets and local config — never commit these
*.env
.env
*.pem
*.key
*.crt
!*.example
# The filled-in config. config.example.yaml is the committed template; this is
# the copy that carries real values, so it must never be tracked.
config.yaml
config.yml

# Proprietary vendor SDK material (Thales ProtectToolkit and friends).
# Licensed, non-redistributable, and never vendored into this repository —
# see docs/protectserver-setup.md. These patterns are a safety net, not the
# policy; the policy is that vendor code lives outside the repo entirely.
libctsw.so
libcthsm.so
libcryptoki.so
libctsw.so.*
libcthsm.so.*
libcryptoki.so.*
/opt/
*.fm
terraform.tfstate
terraform.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Go
/bin/
*.test
*.out
coverage.txt

# OS / editor
.DS_Store
.idea/
.vscode/

# Local run state created by deploy/docker/run-local.sh: SoftHSM2 tokens
# (which hold real private keys, throwaway or not), ceremony artifacts, and
# the CA database. Never committed -- CLAUDE.md §3.1, §3.2.
.local/
